<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/colorSurface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorSurface"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="@string/personal_records"
                        android:textSize="20sp"
                        android:fontFamily="@font/chivo_family"
                        android:textStyle="bold"
                        android:textColor="@color/colorOnSurface"
                        android:letterSpacing="0.04" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="1dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="@color/colorAccentOpaque">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="14dp"
                            android:paddingBottom="14dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/top_3_days"
                                android:textSize="14sp"
                                android:fontFamily="@font/chivo_family"
                                android:textStyle="bold"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.6"
                                android:letterSpacing="0.04"
                                android:textAllCaps="true"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <!--              #1              -->
                            <LinearLayout
                                android:id="@+id/top_day_1_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:background="@drawable/bg_records_top_day_plate"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:minHeight="52dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.28"
                                    android:text="#1"
                                    android:textSize="24sp"
                                    android:fontFamily="@font/chivo_family"
                                    android:textFontWeight="100"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"
                                    android:alpha="0.3"/>

                                <TextView
                                    android:id="@+id/top_day_1_value"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.42"
                                    android:text="..."
                                    android:textSize="24sp"
                                    android:textFontWeight="600"
                                    android:fontFamily="@font/chivo_family"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.3"
                                    android:orientation="vertical"
                                    android:gravity="end|center_vertical">

                                    <TextView
                                        android:id="@+id/top_day_1_distance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textStyle="bold"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.8"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                    <TextView
                                        android:id="@+id/top_day_1_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.55"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                </LinearLayout>

                            </LinearLayout>

                            <!--              #2              -->
                            <LinearLayout
                                android:id="@+id/top_day_2_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:background="@drawable/bg_records_top_day_plate"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:minHeight="52dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.28"
                                    android:text="#2"
                                    android:textSize="24sp"
                                    android:fontFamily="@font/chivo_family"
                                    android:textFontWeight="100"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"
                                    android:alpha="0.3"/>

                                <TextView
                                    android:id="@+id/top_day_2_value"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.42"
                                    android:text="..."
                                    android:textSize="24sp"
                                    android:textFontWeight="600"
                                    android:fontFamily="@font/chivo_family"
                                    android:textColor="@color/colorOnSurface"
                                    android:alpha="0.85"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.3"
                                    android:orientation="vertical"
                                    android:gravity="end|center_vertical">

                                    <TextView
                                        android:id="@+id/top_day_2_distance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.8"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                    <TextView
                                        android:id="@+id/top_day_2_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.55"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                </LinearLayout>

                            </LinearLayout>

                            <!--              #3              -->
                            <LinearLayout
                                android:id="@+id/top_day_3_card"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:background="@drawable/bg_records_top_day_plate"
                                android:gravity="center"
                                android:paddingStart="18dp"
                                android:paddingEnd="18dp"
                                android:minHeight="52dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.28"
                                    android:text="#3"
                                    android:textSize="24sp"
                                    android:fontFamily="@font/chivo_family"
                                    android:textFontWeight="100"
                                    android:textColor="@color/colorOnSurface"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"
                                    android:alpha="0.3"/>

                                <TextView
                                    android:id="@+id/top_day_3_value"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.42"
                                    android:text="..."
                                    android:textSize="24sp"
                                    android:textFontWeight="600"
                                    android:fontFamily="@font/chivo_family"
                                    android:textColor="@color/colorOnSurface"
                                    android:alpha="0.7"
                                    android:gravity="start|center_vertical"
                                    android:includeFontPadding="false"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.3"
                                    android:orientation="vertical"
                                    android:gravity="end|center_vertical">

                                    <TextView
                                        android:id="@+id/top_day_3_distance"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="14sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.8"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                    <TextView
                                        android:id="@+id/top_day_3_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:textSize="11sp"
                                        android:fontFamily="@font/chivo_family"
                                        android:textColor="@color/colorOnSurface"
                                        android:alpha="0.55"
                                        android:gravity="end"
                                        android:includeFontPadding="false"/>

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="10dp" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:text="@string/best_week"
                            android:textSize="14sp"
                            android:fontFamily="@font/chivo_family"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:alpha="0.6"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:id="@+id/best_week_value_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.55"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/best_week_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loading_data"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="5dp" />

                            <TextView
                                android:id="@+id/best_week_start_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <TextView
                                android:id="@+id/best_week_end_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="10dp" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:text="@string/most_walked_month"
                            android:textSize="14sp"
                            android:fontFamily="@font/chivo_family"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:alpha="0.6"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:gravity="start"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:id="@+id/best_month_value_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.55"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/best_month_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loading_data"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="5dp" />

                            <TextView
                                android:id="@+id/best_month_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="10dp" >

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:text="@string/avg_steps_per_day"
                            android:textSize="14sp"
                            android:fontFamily="@font/chivo_family"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:alpha="0.6"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:gravity="start"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:id="@+id/avg_steps_per_day_value_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.55"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/avg_steps_per_day_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loading_data"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="5dp" />

                            <TextView
                                android:id="@+id/avg_steps_per_day_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.08" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:orientation="horizontal"
                        android:paddingVertical="18dp"
                        android:paddingHorizontal="10dp" >

                        <TextView
                            android:id="@+id/streak_record_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:text="@string/streak_record"
                            android:textSize="14sp"
                            android:fontFamily="@font/chivo_family"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:alpha="0.6"
                            android:letterSpacing="0.04"
                            android:textAllCaps="true"
                            android:gravity="start"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:id="@+id/streak_record_value_container"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.55"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/streak_record_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/loading_data"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <Space
                                android:layout_width="1dp"
                                android:layout_height="5dp" />

                            <TextView
                                android:id="@+id/streak_record_start_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                            <TextView
                                android:id="@+id/streak_record_end_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="13sp"
                                android:textFontWeight="300"
                                android:fontFamily="@font/chivo_family"
                                android:textColor="@color/colorOnSurface"
                                android:alpha="0.55"
                                android:gravity="center"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="15dp"
                        android:background="@color/colorAccent"
                        android:alpha="0.08" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/milestone_achievements"
                            android:textSize="20sp"
                            android:fontFamily="@font/chivo_family"
                            android:textStyle="bold"
                            android:textColor="@color/colorOnSurface"
                            android:letterSpacing="0.04"
                            android:layout_centerInParent="true" />

                        <ImageButton
                            android:id="@+id/btn_milestone_notifications"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_notification_button"
                            android:src="@drawable/ic_notifications_active"
                            android:contentDescription="@string/milestone_notifications_toggle"
                            app:tint="@color/colorOnSurface" />

                    </RelativeLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/milestones_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/no_milestones_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/chivo_family"
                        android:paddingVertical="48dp"
                        android:text="@string/no_milestones_reached"
                        android:textAlignment="center"
                        android:textColor="@color/colorAccent"
                        android:textFontWeight="600"
                        android:textSize="18sp"
                        android:visibility="visible" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>