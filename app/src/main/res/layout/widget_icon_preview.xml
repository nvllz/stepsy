<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_icon_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widgetBackground_default">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_icon_img"
            android:layout_width="34dp"
            android:layout_height="44dp"
            android:layout_marginEnd="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notification"
            android:tint="@color/widgetPrimary_default"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_icon_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="7587"
                android:textAlignment="center"
                android:textColor="@color/widgetPrimary_default"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_icon_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="5.60 km"
                android:textAlignment="center"
                android:textColor="@color/widgetSecondary_default"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
