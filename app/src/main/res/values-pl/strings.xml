    <string name="onboarding_card_battery_title">Popraw stabilność w tle</string>
    <string name="onboarding_card_battery_summary">Stepsy jest lekka z założenia, ale system może uniemożliwiać jej niezawodne liczenie kroków. Pozwól aplikacji działać w tle.</string>
    <string name="onboarding_strip_title">Kroki nie są liczone</string>
